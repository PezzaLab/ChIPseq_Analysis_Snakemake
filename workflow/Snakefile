        "Results/{genomes_not_fused}/Qctrl/{sample}/{bam_type}/{sample}.samstats.txt" # This file is actualy just a txt file, but to be able to use expand in multiqc I am using .tab
    threads: 2
    envmodules:
        config["samtools"],
    shell:
        """
    samtools stats {input.bam} > {output}
        """

