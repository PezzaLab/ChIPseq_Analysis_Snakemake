rule FRIP:
    input:
        peak = "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type}/"
                   "{peak_params}/Black-grey_filtered/{sample}."
                   "{genomes_final}{extension}.{peak_type}Peak",
        bam = lambda w: samples_table_2.loc[
                            w.sample, "dedup_flt_both_strds_bam"],
        bai = lambda w: samples_table_2.loc[
                            w.sample, "dedup_flt_both_strds_bam"] + ".bai",
    output:
        "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/FRIP/"
            "MACS2_{peak_type}_{peak_params}_bl-gr_flt/"
            "{sample}.{genomes_final}{extension}.FRIP.txt",
    threads: 1
    envmodules:
        config["sambamba"],
        config["samtools"],
    shell:
        """
        echo "Getting total number of reads"
        total_reads=$( sambamba view -c {input.bam} )

        # Get reads in peak list
        echo "Getting number of reads in peaks"
        peak_reads=$( samtools view -L {input.peak} -c {input.bam} )

        FRIP=$( echo "scale=2; 100 * $peak_reads / $total_reads" | bc )

        echo "
        Sample name: $(basename {input.bam} bam)
        Total reads: $total_reads
        Reads in peaks: $peak_reads
        FRIP (%): $FRIP
        Anything below 1% is not good..." > {output}
        """

rule crosscorrelation: 
# only for processed bam
    input:
        lambda w: samples_table_2.loc[w.sample,'dedup_flt_both_strds_bam'],
    output:
        pdf = "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/"
                "{sample}.crosscorrelation.pdf",
        tab = "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/"
                "{sample}.crosscorrelation.spp.out", 
        # the suffix ".spp.out" is so that the file is recognized by multiqc
    threads: 2
    envmodules:
        config["phantompeakqualtools"],
        config["samtools"],
        config["sambamba"],
        config["picard"],
        config["deeptools"],
    shell:
        """
        run_spp.R -c="{input}" -savp="{output.pdf}" -out="{output.tab}"
        """

