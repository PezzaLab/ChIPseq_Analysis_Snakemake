rule dros_normalization_report:
    input:
        smkf.dros_normalization_report_input,
    output:
        "Results/d6/Analysis/drosophila_normalization/{dros_eq_group}/"
            "drosophila_equalization_report.tsv",
    threads: 1
    params:
        samples_table_2 = samples_table_2,
    script:
