rule insert_size_picard: # Only processed bam and PE. I put {bam_type} wildcard though to be able to use the function to get the input bam/bai
    input:
        lambda w: samples_table_2.loc[w.sample,'dedup_flt_both_strds_bam']
    output:
        tab = "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/{sample}.insert_size_picard.tab",
        pdf = "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/{sample}.insert_size_picard.pdf"
    threads: 2
    envmodules:
        config["picard"],
        config["R"]
    shell:
        """
    	picard CollectInsertSizeMetrics M=0.25 I={input} O={output.tab} H={output.pdf} VALIDATION_STRINGENCY=LENIENT ASSUME_SORTED=true VERBOSITY=INFO
        """

rule library_complexity_picard: # only raw bam and PE
    input:
        lambda w: samples_table_2.loc[w.sample, 'raw_bam'] # If I don't convert the wildcards to list, it returns a warning
    output:
        "Results/{genomes_not_fused}/Qctrl/{sample}/Raw_bam/{sample}.picard_library_complexity.tab"
    threads: 2
    envmodules:
        config["picard"]
    shell:
        """
    	picard EstimateLibraryComplexity I={input} O={output} VALIDATION_STRINGENCY=LENIENT VERBOSITY=INFO
        """

rule multiqc:
    input:
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/{sample}.crosscorrelation.spp.out",
        sample = samples_table['sample_name'].tolist()
        ),
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/{sample}.insert_size_picard.tab",
        sample = samples_table.loc[samples_table['PE'], 'sample_name'].tolist()
        ), # insert size only applies for PE samples
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Raw_bam/{sample}.picard_library_complexity.tab",
        sample = samples_table.loc[~samples_table['sample_name'].str.endswith("MERGED"), 'sample_name'].to_list() # Not applying this to merged files since they have already been dedupped. Before the command was: samples_table['sample_name'].tolist()
        ),
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/{sample}.{ext}",
        sample = samples_table['sample_name'].tolist(),
        ext = ["samstats.txt", "flagstat.txt"]
        ),
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Raw_bam/{sample}.{ext}",
        sample = samples_table.loc[~samples_table['sample_name'].str.endswith("MERGED"), 'sample_name'].to_list() ,
        ext = ["samstats.txt", "flagstat.txt"] # Not applying this to merged files since they have already been dedupped. Before the command was: sample=samples_table['sample_name'].tolist()
        )
    output:
        directory("Results/{genomes_not_fused}/Qctrl/multiqc_report_{library}_data"),
        html = "Results/{genomes_not_fused}/Qctrl/multiqc_report_{library}.html"
    threads: 2
    envmodules:
        config["multiqc"]
    shell:
        """
config_file_path="$(pwd)/Config/multiqc_config.yaml"
cd Results/{wildcards.genomes_not_fused}/Qctrl && \
multiqc --dirs --dirs-depth 1 --filename "multiqc_report_{wildcards.library}.html" --config $config_file_path ./
# --dirs       : use directory name as part of sample name (not to overwrite data with same file name)
# --dirs-depth : how many directories should be used for the name of the sample
# --config     : path for config file
        """


