            "{sample}.picard_library_complexity.tab",
    threads: 2
    envmodules:
        config["picard"],
    shell:
        """
    	picard EstimateLibraryComplexity I={input} O={output} \\
         VALIDATION_STRINGENCY=LENIENT VERBOSITY=INFO
        """

rule multiqc:
    input:
        expand(
            "Results/FASTQ_reports/{sample}.{PE}.fastp.json",
            sample = samples_table['sample_name'].tolist(),
            PE = "PE" if samples_table['PE'].all() else "SE"
            ),
        expand(
            "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/"
                "{sample}.crosscorrelation.spp.out",
            sample = samples_table['sample_name'].tolist()
        ),
        expand(
            "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/"
                "{sample}.insert_size_picard.tab",
            sample = samples_table.loc[
                samples_table['PE'], 
                'sample_name',
                ].tolist()
        ), # insert size only applies for PE samples
        expand(
            "Results/{{genomes_not_fused}}/Qctrl/{sample}/Raw_bam/"
                "{sample}.picard_library_complexity.tab",
            sample = samples_table.loc[
                ~samples_table['sample_name'].str.endswith("MERGED"), 
                'sample_name',
                ].to_list(), # Not applying this to merged files since they have already been dedupped. Before the command was: samples_table['sample_name'].tolist()
        ),
        expand(
            "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/"
                "{sample}.{ext}",
            sample = samples_table['sample_name'].tolist(),
            ext = ["samstats.txt", "flagstat.txt"],
        ),
        expand(
            "Results/{{genomes_not_fused}}/Qctrl/{sample}/Raw_bam/"
                "{sample}.{ext}",
            sample = samples_table.loc[
                ~samples_table['sample_name'].str.endswith("MERGED"), 
                'sample_name',
                ].to_list(),
            ext = ["samstats.txt", "flagstat.txt"] # Not applying this to merged files since they have already been dedupped. Before the command was: sample=samples_table['sample_name'].tolist()
        )
    output:
        directory(
            "Results/{genomes_not_fused}/Qctrl/multiqc_report_{library}_data"
            ),
        html = "Results/{genomes_not_fused}/Qctrl/"
                    "multiqc_report_{library}.html",
    threads: 2
    envmodules:
        config["multiqc"],
    shell:
        """
config_file_path="$(pwd)/Config/multiqc_config.yaml"
cd Results/{wildcards.genomes_not_fused}/Qctrl && \
multiqc --dirs --dirs-depth 1 \\
 --filename "multiqc_report_{wildcards.library}.html" \\
 --config $config_file_path ./ ../../FASTQ_reports
# --dirs       : use directory name as part of sample name 
#               (not to overwrite data with same file name)
# --dirs-depth : how many directories should be used for the name of 
#                the sample
# --config     : path for config file
        """


