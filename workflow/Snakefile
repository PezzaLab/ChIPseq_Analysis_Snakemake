rule dros_normalization:
    input:
        unpack(smkf.dros_norm_input)
    output:
        "Results/{genomes_not_fused}/Bigwigs/Coverage/{strands}/{cov_params}/Drosophila_normalized/{dros_eq_group}/{sample}.{genomes_final}{extension}{strand}.dros_norm.bw",
    params:
        smooth = config['coverage']['smooth'],
        bin = config['coverage']['bin_size'],
        normalize = config['coverage']['normalization'],
        extend_reads = config['coverage']['extend_reads']
    threads: 1
    envmodules:
        "deeptools/3.4.3"
    shell:
        """
scaleFactor=$(awk 'BEGIN {{FS="\t"}} $1 == "{wildcards.sample}" {{print $4}}' {input.report})

echo -e "scaleFactor = $scaleFactor \n"

if (( $(echo "$scaleFactor < 1" | bc -l) )); then
  echo "Sample will be scaled down with a scale factor of $scaleFactor"
  bamCoverage --numberOfProcessors max -b {input.bam} -bs {params.bin} --smoothLength {params.smooth} --normalizeUsing {params.normalize} -o {output} --scaleFactor $scaleFactor
else
  unscaled_bw=$(readlink -f {input.unscaled_bw})
  echo "sample will not be re-scaled, creating symbolic link to original coverage bigwig file (${{unscaled_bw}})"
  ln --symbolic --relative "${{unscaled_bw}}" "{output}"
  # --relative : create symbolic links relative to link location
fi
        """

