    "Results/" + samples_table_2['reference_genome'] +
    "/Bigwigs/Coverage/Single_strand/Full_length_reads/" + cov_params +
    "Drosophila_normalized/" + samples_table['dros_equalization_group'] + "/" +
    samples_nodup_filt + ".exc_16.dros_norm.bw"]

samples_table_2['dros_eq_83_or_i16_cov'] = (
    np.select(conditions_dros_eq,
              choices_ss_83_or_i16_bam,
              default=np.NaN)
    )
samples_table_2['dros_eq_99_or_e16_cov'] = (
    np.select(conditions_dros_eq,
              choices_ss_99_or_e16_cov,
              default=np.NaN)
    )

### Save table for debugging
samples_table_2.to_csv("Config/samples_table_2.csv")


###################################################
##### Get list of files to call in rule all: ######
###################################################

hs_agg_profs = []
for region in ["top_5000_plus_minus_2000", "x_non_par", "autosomal_x_non_par_ctrl", "asymetric_watson_strong", "asymetric_crick_strong"]:
    hs_agg_profs += [f"Results/mm10/Analysis/Heatmaps_and_aggregate_profiles/Hotspots/{region}.RData"]

peak_summaries = []
ref_genomes = samples_table['reference_genome'].unique().tolist()
for genomes in ref_genomes:
    peak_summaries += [f"Results/{genomes}/Analysis/Peaks_summary.tsv"]
# Get single strand files (ss), black-list filtered peak lists (peak_bl),
# FRIP values, drosophila deduplicated bam files, heatmaps
files_df = samples_table_2.filter(regex="^(ss|peak_bl|FRIP|both|dros_dedup_bam|processed_flagstat_dros|merged_dedup|heatmap|dros_eq_).*") # Filter columns using regex to match name of column
files_array = files_df.to_numpy().ravel()
files_list = files_array[~pd.isnull(files_array)].tolist()
files_list += peak_summaries

# pre_formed_strings (put this aside later)
cov_config_params_string=f"{config['coverage']['normalization']}_bs{config['coverage']['bin_size']}_sm{config['coverage']['smooth']}"
#cov_param_clipped_string=f"{config['coverage']['normalization']}_bs1_sm1" # Not in use for now...

