rule intersect_peaks_HSs_list:
    input:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/{sample}.{genomes_final}{extension}.{peak_type}Peak"
    output:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/Intersect_HSs_plus_minus_2000_bp/{sample}.{genomes_final}{extension}.{peak_type}Peak"
    wildcard_constraints:
        peak_type="broad|narrow",
        peak_type_folder="Broad|Narrow"
    # log:
    #     "Results/Log_files/intersect_peaks_HSs_list/{genomes_not_fused}/{peak_type_folder}.{peak_type}/{peak_params}/{sample}.{genomes_final}.{extension}log"
    threads: 1
    envmodules:
        config["bedtools"]
    params:
        hs_list = lambda w: config['references'][w.genomes_not_fused]['spo11']['all_plus_minus_2000']
    shell:
