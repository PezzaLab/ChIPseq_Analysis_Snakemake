# To be able to produce different early-products of processing, I either have to
# set differnt names in all final products according to those early changes (and 
#restrict regex of following rules to use right products) or, I can set up the initial 
# rule (where change happens) according to parameters... the problem with the later 
# methodology is that I would have to put many steps in one rule...

rule all: # Call for cov files ()
    input:
        files_list,
        expand(
        "Results/{genomes}/Qctrl/multiqc_report_{lib_name}.html",
        genomes = samples_table["reference_genome"].unique().tolist(),
        lib_name = config['library']['name']
        ),
        expand(
        "Results/{genomes}/Analysis/{lib_name}.html",
        genomes = samples_table["reference_genome"].unique().tolist(),
        lib_name = config['library']['name']
        ),


        # Cov. Dedup merged
            # This should probably go on a separate folder (not the library folder, 
            # since it does not correspond to any library in particular by definition)
        # IDR Analysis
            # Same as merged files analysis since most of the times both files 
            # do not belong to the same library

wildcard_constraints: # Automate constrain expression depending on config or sample file (which genomes are there?)
    sample="[^./ ]+", # Name of files cannot contain . or / or space
    sample_with_extensions="[^/]+",
    strands="Both_strands|Single_strand/(1bp_clipped_reads|Full_length_reads)",
    int_genome="mm10|hg19|hg38",
    spike_genome="d6",
    genomes_not_fused="mm10|d6|hg19|hg38",
    genomes_all="mm10|d6|hg19|hg38|mm10_f_d6|hg19_f_d6|hg38_f_d6",
    fused_genome="(mm10_f_d6|hg19_f_d6|hg38_f_d6)",
    cov_params="(CPM|RPKM|none)_bs[0-9]+_sm[0-9]+",
    genomes_final="(?<=\.)(?P<interest_genome>mm10|hg19|hg38)+(_f_d6\.((?P=interest_genome)|d6))?(?=\.)",
    ss_PE="83-163|99-147",
    clipped_1bp_PE="((inc|exc)_16\.clipped_1_bp\.)?",
    ss_SR="(inc|exc)_16",
    peak_params="(bco_[0-9]+_)?qv_[0-9]+__[^/]*",
    hs_region =  "top_5000_plus_minus_2000|asymetric_watson_strong|asymetric_crick_strong|x_non_par|autosomal_x_non_par_ctrl",
    bam_type = "Raw_bam|Processed_bam",
    extension = "(\.q_filt\.srt\.nodup\.mit_filt)?",
    strand = "(\.(83-163|99-147|inc_16|exc_16))?",
    library_name = config['library']['name'],
    dros_eq_group="[^./ ]+"

ruleorder: get_strand_sep_pe_bams > dedup_bam > index
ruleorder: merge_bams > align_fastq
localrules: filter_peaks_blk_grey_list, filter_peaks_blk_grey_list, intersect_peaks_HSs_list, sumarize_peak_count#, dros_normalization_report#,markdown_report_aggregate_profiles

