rule compute_matrix_outfiles_hs:
    # Use deeptools to generate a coverage matrix over a set of regions
    # determined in a bedfile.
    input:
        unpack(smkf.compute_matrix_outfiles_hs_input),
    output:
        filename = temp(
            "Results/{genomes_not_fused}/Analysis/"
                "Heatmaps_and_aggregate_profiles/Hotspots/{hs_region}/{strands}/"
                "{cov_params}/filenames/"
                "{sample}.{genomes_final}.q_filt.srt.nodup.mit_filt."
                "{ss_condit}{clip_condit}filename"),
        matrix = "Results/{genomes_not_fused}/Analysis/"
            "Heatmaps_and_aggregate_profiles/Hotspots/{hs_region}/{strands}/"
                "{cov_params}/matrixes/"
                "{sample}.{genomes_final}.q_filt.srt.nodup.mit_filt."
                "{ss_condit}{clip_condit}matrix",
    # log:
    #     ""
    threads: 1
    envmodules:
        config["deeptools"],
    resources:
        mem_mb = lambda wildcards, input, attempt: (
             3000 * attempt
        ),
        runtime = lambda wildcards, input, attempt: (
            "{minutes}min".format(
                minutes= int(
                   attempt * 5
                ),
            )
        ),
    benchmark:
        "benchmarks/compute_matrix_outfiles_hs/{genomes_not_fused}_"
        "{hs_region}_{strands}_{cov_params}/"
        "{sample}.{genomes_final}.{ss_condit}{clip_condit}.tsv"
    shell:
        """
        computeMatrix reference-point -p max -R {input.region} \\
          -S {input.bigwig} \\
          --sortRegions keep \\
          -b {config[heatmaps][before_region]} \\
          -a {config[heatmaps][after_region]} \\
          --outFileName {output.filename} \\
          --outFileNameMatrix {output.matrix} \\
          --referencePoint center \\
          --binSize {config[heatmaps][bin_size]}
        """

rule process_aggregate_profiles:
    """Average over all loci, smooth and normalize signal from \
    'compute_matrix_outfiles_hs' rule's output

     'hs_region' can be one of the following:
     'LibName_top_5000_plus_minus_2000',  'LibName_aggregate_profiles_data',
     'LibName_top_5000_B6xCAST',
     'LibName_B6xCAST_PRDM9_assymetric_hs_invading_strand' and
     'LibName__B6xCAST_PRDM9_assymetric_hs_receiving_strand'.

     The first 3 pertain mm10 (B6) aligned data. All the others are for
     data aligned to a B6-CAST fusion (mm10 assembly).

     Input function (process_aggregate_profiles_inputs) returns a list with
     all available *.matrix files for that particular {hs_region}
    """
    # TODO: improve docstring
    input:
        unpack(smkf.process_aggregate_profiles_inputs),
    output:
        "Results/{genomes_not_fused}/Analysis/Heatmaps_and_aggregate_profiles/"
            "Hotspots/{library_name}_{hs_region}.{smooth}.RData",
    threads: 1
    envmodules:
        config["R"],
        config["bioconductor"],
    params:
        genomes = config['genomes'].keys(),
    resources:
        mem_mb = lambda wildcards, input, attempt: (
             input.size_mb + 1000
        ),
        runtime = lambda wildcards, input, attempt: (
            "{minutes}min".format(
                minutes= int(
                   attempt * 15
                ),
            )
        ),
    benchmark:
        "benchmarks/process_aggregate_profiles/{genomes_not_fused}/"
        "{library_name}_{hs_region}.{smooth}.tsv"
    script:
        "Scripts/process_outfile_matrix.R"

