# Index rule should create all indexes (as long as I ask for them. In final bams
#  I will have to ask for them, on the rest it won't be necessary)
rule index:
    input:
        "{sample}.bam" # In this case, sample wildcard can be anything (path included)
    output:
        "{sample,.+}.bam.bai" # In this case, sample can be anything (path included), 
        # hence I need to override the global wildcard constrain (which does not allow paths on sample wildcard)
    # log:
    #     "{sample}.index.log"
    threads: 2
    envmodules:
        "sambamba/0.8.2"
    shell:
        """
        sambamba index {input}
        """

rule align_fastq: 
# Alignement should take into account the sequencing mode (SR or PE),
# the species of interest, the spike in, and the technology used to do the library
#  (adaptase or regular). For now I'll forget about o3.
    input:
        unpack(smkf.get_input_align)
    output:
        bam = "Results/{sample}.{genomes_all}.bam",  # How do I use scratch temp dir here?  # Make this output temp? #
        fastp_json = "Results/{genomes_all}/Qctrl/{sample}/Raw_FASTQ/{sample}_fastp.json", 
        # This is actually not right, the fastp report is on the FASTQ file, not "raw bam", 
        # and should be placed on final genomes, not all genemos (drosophila fusions not included). 
        # So, it should be on: "Results/{final_genomes}/Qctrl/{sample}/FASTQ/{sample}_fastp.json"
        fastp_html = "Results/{genomes_all}/Qctrl/{sample}/Raw_FASTQ/{sample}_fastp.html"
    params:
        genome_path = lambda w: config['genomes'][w.genomes_all],
        library_tech = lambda w: samples_table.loc[w.sample, "library_technology"],
        PE = lambda w: str(samples_table.loc[w.sample, "PE"]).lower()
    # log:
    #     "Results/Log_files/align_spiked_fastq/{sample}.{genomes_all}.log"
    threads: 2
    envmodules:
        "fastp/0.23.2",
        "bwa/0.7.15",
        "sambamba/0.8.2",
        "samtools/1.14"
    shell: # I need to assemble the command as a string and the "eval" it, 
    # otherwise it doesn't work. Another workaround is to use wrappers (there is a wrapper that does this)
        """
input2=""
PE_adaptase=""
echo "determining alignement conditions..."
if [[ "{params.PE}" == "true" ]]; then
  input2="-I {input.fastq2} "
  echo "Data is PE"
  if [[ "{params.library_tech}" == "adaptase" ]]; then
PE_adaptase="fastp \\
--stdin \\
--interleaved_in \\
--trim_front2 10 \\
--stdout |"
echo "Library technology: Adaptase"
fi
fi
echo "finished the first part"

command="
fastp \\
-i {input.fastq1} $input2 \\
--html {output.fastp_html} \\
--json {output.fastp_json} \\
--stdout | $PE_adaptase \\
bwa mem -v 1 -M -p -t $SLURM_CPUS_ON_NODE {params.genome_path} - \\
| samtools sort -@ $SLURM_CPUS_ON_NODE -O bam -o {output.bam}"

#sambamba sort --nthreads $SLURM_CPUS_ON_NODE -o {output.bam} /dev/stdin # --. Apparently sambamba sort only takes bam files

eval $command
        """

rule filter_spiked_in_bam_int_genome:
    input:
        bam="Results/{sample}.{fused_genome}.bam",
        bai="Results/{sample}.{fused_genome}.bam.bai" # To view by chr needs a bai
    output:
        "Results/{sample}.{fused_genome}.{int_genome}.bam"
    # log:
    #     "Results/Log_files/filter_spiked_in_bam_int_genome/{sample}.{fused_genome}.{int_genome}.log"
    params:
        spike_suffix= lambda w: config['spike_in_suffixes'][w.fused_genome]
    threads: 2
    envmodules:
        "samtools/1.14",
        "sambamba/0.8.2"
    shell:
        """
        int_chromsomes=$(samtools idxstats {input.bam} | \\
         cut -f 1 | grep -v .*{params.spike_suffix} | \\
         grep -v \* | paste  -sd ' ')
        sambamba view --nthreads $SLURM_CPUS_PER_TASK --format bam -o {output} {input.bam} $int_chromsomes
        """

rule filter_spiked_in_bam_spike_in_genome:
    input:
        bam="Results/{sample}.{fused_genome}.bam",
        bai="Results/{sample}.{fused_genome}.bam.bai"
    output:
        "Results/{sample}.{fused_genome}.{spike_genome}.bam"
    # log:
    #     "Results/Log_files/filter_spiked_in_bam_spike_in_genome/{sample}.{fused_genome}.{spike_genome}.log"
    params:
        spike_suffix= lambda w: config['spike_in_suffixes'][w.fused_genome]
    threads: 2
    envmodules:
        "sambamba/0.8.2",
        "samtools/1.14"
    shell:
        """
        spike_chromsomes=$(samtools idxstats {input.bam} | cut -f 1 | grep .*{params.spike_suffix} | grep -v \* | paste  -sd ' ')
command="sambamba view --nthreads $SLURM_CPUS_PER_TASK --format bam -o {output} {input.bam} $spike_chromsomes"
        echo $command
        eval $command
        """

rule dedup_bam:
    input:
        bam = "Results/{sample}.{genomes_final}.bam",
        bai = "Results/{sample}.{genomes_final}.bam.bai" # Is this necessary?
    output:
        bam = temp("Results/{genomes_not_fused}/{sample}.{genomes_final}.nodup.bam"),
        qctrl = "Results/{genomes_not_fused}/Qctrl/{sample}/Raw_bam/{sample}.{genomes_final}.markDup_raw.txt",
        bai = temp("Results/{genomes_not_fused}/{sample}.{genomes_final}.nodup.bai")
    # log:
    #     "Results/Log_files/dedup/{genomes_not_fused}{sample}.{genomes_final}.log"
    threads: 2
    envmodules:
        "picard/2.21.2"
    shell:
        """
        picard MarkDuplicates I={input.bam} O={output.bam} M={output.qctrl} VALIDATION_STRINGENCY=LENIENT ASSUME_SORTED=true REMOVE_DUPLICATES=TRUE VERBOSITY=INFO CREATE_INDEX=TRUE
        """

rule filter_bam:
    input:
        bam = "Results/{genomes_not_fused}/{sample}.{genomes_final}.nodup.bam",
        bai = "Results/{genomes_not_fused}/{sample}.{genomes_final}.nodup.bam.bai",
    output:
        "Results/{genomes_not_fused}/Bams/Both_strands/{sample}.{genomes_final}.q_filt.srt.nodup.mit_filt.bam"
    # log:
    #     "Results/Log_files/filter_bam/{genomes_not_fused}/{sample}.{genomes_final}.log"
    params:
        min_mapping_qual = lambda w: config['min_mapping_qual'],
        PE = lambda w: str(samples_table.loc[w.sample, "PE"]).lower()
    threads: 2
    envmodules:
        "samtools/1.14",
        "sambamba/0.8.2"
    shell:
        """
chromsomes=$(samtools idxstats {input.bam} | cut -f 1 \\
| grep -v MT | grep -v chrM | grep -v \* | paste  -sd ' ') # This is to filter out mitochondrial reads

if [[ "{params.PE}" == "true" ]]; then
  echo "Data is PE"
  filter="-F 3852 -f 3"
else
echo "Data is SR"
  filter="-F 3844"
fi

command="samtools view \\
-q {params.min_mapping_qual} \\
-b \\
-@ $SLURM_CPUS_ON_NODE \\
${{filter}} \\
-o {output} \\
{input.bam} $chromsomes"

echo "Command:
$command"
eval $command

# Flags
    # 3852 = read or mate unmapped, not primary alignement, read fails platform/vendor quality checks, read is PCR or optical duplicate, supplementary alignment
    # 3 = read paired and read mapped in proper pair
    # 3844 = read unmapped, not primary alignement, read fails platform/vendor quality checks, read is PCR or optical duplicate, supplementary alignment
        """

rule get_strand_sep_pe_bams: # Do I need to separate 83 AND 163 or are the both the same?
    input:
        bam="Results/{genomes_not_fused}/Bams/Both_strands/{sample_with_extensions}.bam"
    output:
        bam=temp("Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.{flag}.bam"),
        bai=temp("Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.{flag}.bam.bai"), # Index is needed for next merge_watson_or_crick and is also temp, that is why it is not done by index rule
    wildcard_constraints:
        flag="(83|163|99|147)"
    # log:
    #     "Results/Log_files/get_strand_sep_pe_bams/{genomes_not_fused}/{sample_with_extensions}.{flag}.log"
    threads: 2
    envmodules:
        "samtools/1.14"
    shell:
        """
        samtools view -b -f {wildcards.flag} {input.bam} > {output.bam}
        samtools index {output.bam}
        """

rule merge_watson_or_crick: # If the next rule works for both SR and PE, erase this rule
    input:
        flag1="Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.{flag1}.bam",
        index_1="Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.{flag1}.bam.bai",
        flag2="Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.{flag2}.bam",
        index_2="Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.{flag2}.bam.bai"
    output:
        "Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.{flag1}-{flag2}.bam"
    wildcard_constraints:
        flag1="(83|99)",
        flag2="(163|147)"
    # log:
    #     "Results/Log_files/merge_watson_or_crick/{genomes_not_fused}/{sample_with_extensions}.{flag1}-{flag2}.log"
    threads: 2
    envmodules:
        "samtools/1.14"
    shell:
        """
        samtools merge {output} {input.flag1} {input.flag2}
        """

rule get_rv_fw_strand:
    input:
        smkf.get_rv_fw_strand_input
        #"Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.bam",
        #"Results/{genomes_not_fused}/Bams/Both_strands/{sample_with_extensions}.bam"
    output:
        inc_16="Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.inc_16.bam",
        exc_16="Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.exc_16.bam"
    # log:
    #     "Results/Log_files/get_rv_fw_strand/{genomes_not_fused}/{sample_with_extensions}.log"
    threads: 2
    envmodules:
        "samtools/1.14"
    shell:
        """
        samtools view -b -f 16 {input} > {output.inc_16}
        samtools view -b -F 16 {input} > {output.exc_16}
        """

rule create_coverage_bw:
    input:
        bam="Results/{genomes_not_fused}/Bams/{strands}/{sample}.{genomes_final}.q_filt.srt.nodup.mit_filt.{ss_condit}{clip_condit}bam",
        bai="Results/{genomes_not_fused}/Bams/{strands}/{sample}.{genomes_final}.q_filt.srt.nodup.mit_filt.{ss_condit}{clip_condit}bam.bai"
    output:
        "Results/{genomes_not_fused}/Bigwigs/Coverage/{strands}/{cov_params}/{sample}.{genomes_final}.q_filt.srt.nodup.mit_filt.{ss_condit}{clip_condit}bw"
    # log:
    #     "Results/Log_files/create_coverage_bw/{genomes_not_fused}.{strands}/{sample}.{genomes_final}.q_filt.srt.nodup.mit_filt.{ss_condit}{clip_condit}{cov_params}.log"
    wildcard_constraints:
        ss_condit="(((83-163|99-147)|(inc_16|exc_16))\.)?",
        clip_condit="(((inc|exc)_16\.)?clipped_1_bp\.)?"
    params:
        smooth = config['coverage']['smooth'],
        bin = config['coverage']['bin_size'],
        normalize = config['coverage']['normalization'],
        extend_reads = config['coverage']['extend_reads']
    threads: 2
    envmodules:
        "deeptools/3.4.3"
    shell: # The coverage will be different depending on weather the bam's been clipped or not. If clipped, then cov smooth and bin  == 1, otherwise use config file parameters
        """
        if [ -z {wildcards.clip_condit} ] # Cannot do the test [[ curly_brace empty_variable curly_brace == "" ]], won't work
        then
        echo "Doing smooth and bin according to config file (not clipped profile)"
        bamCoverage --numberOfProcessors max -b {input.bam} -bs {params.bin} --smoothLength {params.smooth} --normalizeUsing {params.normalize} -o {output}
        else
        echo "Doing smooth 1 and bin 1 (clipped profile)"
        bamCoverage --numberOfProcessors max -b {input.bam} -bs 1 --smoothLength 1 --normalizeUsing {params.normalize} -o {output}
        fi
        """

rule clip_1bp:
    input:
        "Results/{genomes_not_fused}/Bams/Single_strand/Full_length_reads/{sample_with_extensions}.{flag16}.bam"
    output:
        bam="Results/{genomes_not_fused}/Bams/Single_strand/1bp_clipped_reads/{sample_with_extensions}.{flag16}.clipped_1_bp.bam",
        tmp_dir=temp(directory("Results/{genomes_not_fused}/Bams/Single_strand/1bp_clipped_reads/{sample_with_extensions}.{flag16}/temp_clip_1bp"))
    wildcard_constraints:
        flag16="inc_16|exc_16"
    # log:
    #     "Results/Log_files/clip_1bp/{genomes_not_fused}/{sample_with_extensions}.{flag16}.log"
    threads: 2
    envmodules:
        "samtools/1.14",
        "bamutil/1.0.15"
    shell:
        """
        set -x
        temp_dir="{output.tmp_dir}"

        mkdir -p $temp_dir

        # Get header and sam file
        samtools view -H {input} > ${{temp_dir}}/header

        # Clip reads

        samtools view {input} | \\
        awk -v dir="${{temp_dir}}" '{{read_length=length($10)}} {{print $0 >> dir "/" read_length ".sam" }} '

        sam_files=$(find ./${{temp_dir}} -regextype awk -iregex ".*sam$")

        for sam in ${{sam_files}}; do
          read_length=$(basename $sam .sam)
          clip_length=$(( $read_length - 1 ))
          echo -e "clippping reads of readlength = $read_length \\n"
          cat ${{temp_dir}}/header $sam |
          bam trimBam - - -R $clip_length --clip | \
          samtools sort -n -o - - | \
          samtools fixmate - - | \
          samtools sort - -o ${{temp_dir}}/${{read_length}}_clipped_temp.bam
        done

        # Merge them
        bam_files=$(find ./${{temp_dir}} -regextype awk -iregex ".*bam$" -type f | tr "\\n" " ")
        samtools merge -o {output.bam} $bam_files
        """

rule call_peaks_macs2: # Check on the original script I get a file with the name "._peaks.broadPeak". Should take out that ._peaks.
    input:
        unpack(smkf.MACS2_peak_calling_files)
    output:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/{sample}.{genomes_final}{extension}_peaks.{peak_type}Peak" # Check the file name
    params:
        smkf.get_MACS2_params # Within params, `unpack` is not allowed, instead return a dictionary and access it via {params[0][mykey]}. Not sure why the [0]. Appaerently params is a list, and the first item is the dict...
    # log:
    #     "Results/Log_files/call_peaks_macs2/{genomes_not_fused}/{peak_type_folder}.{peak_type}/{sample}.{genomes_final}{extension}.{peak_params}.log"
    wildcard_constraints:
        peak_type="broad|narrow",
        peak_type_folder="Broad|Narrow",
        extension = "(\.q_filt\.srt\.nodup\.mit_filt)?"
    threads: 2
    envmodules:
        "macs2/2.2.7.1"
    shell:
        """
        directory=$(dirname {output})
        macs2 callpeak --outdir $directory --name {wildcards.sample}.{wildcards.genomes_final}{wildcards.extension} -t {input.treat_bam} {params[0][ctrl]} -g {params[0][genome]} {params[0][qv_bco]} {params[0][PE]} {params[0][peak_type_options]}
        """

rule filter_peaks_blk_grey_list:
    input:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/{sample}.{genomes_final}{extension}_peaks.{peak_type}Peak"
    output:
        final="Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/{sample}.{genomes_final}{extension}.{peak_type}Peak",
        temp=temp("Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/{sample}.{genomes_final}{extension}.{peak_type}Peak.temp")
    wildcard_constraints:
        peak_type="broad|narrow",
        peak_type_folder="Broad|Narrow",
        extension = "(\.q_filt\.srt\.nodup\.mit_filt)?"
    # log:
    #     "Results/Log_files/filter_peaks_blk_grey_list/{genomes_not_fused}/{peak_type_folder}.{peak_type}/{sample}.{genomes_final}{extension}.{peak_params}.log"
    threads: 1
    envmodules:
        "bedtools/2.30.0"
    params:
        blck_gry_lst = lambda w: config['references'][w.genomes_not_fused]['black_grey']
    shell:
        """
        bedtools intersect -wa -v -a {input} -b {params.blck_gry_lst} > {output.temp}
        awk 'BEGIN {{ OFS = "\t"}} {{print $0, ($1 ":" $2 "-" $3)}}' {output.temp} > {output.final}
        """

rule annotate_peaks:
    input:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/{sample}.{genomes_final}{extension}.{peak_type}Peak"
    output:
        anno_peaks = temp("Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/{sample}.{genomes_final}{extension}.{peak_type}Peak.homer_anotated.tsv"),
        genome_ontology = directory("Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/Genome_ontology/{sample}.{genomes_final}{extension}.{peak_type}")
    threads: 1
    envmodules:
        "homer/4.7",
    shell:
        """
        annotatePeaks.pl {input} {wildcards.genomes_not_fused} -genomeOntology {output.genome_ontology} > {output.anno_peaks}
        """

rule modify_annotated_peaks:
    input:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/{sample}.{genomes_final}{extension}.{peak_type}Peak.homer_anotated.tsv"
    output:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/Annotated_peaks/{sample}.{genomes_final}{extension}.{peak_type}Peak.annotated.tsv"
    threads: 1
    envmodules:
        "R/4.1.2-mkl",
