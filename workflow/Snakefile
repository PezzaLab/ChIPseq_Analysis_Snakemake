rule markdown_report_aggregate_profiles:
    # https://stackoverflow.com/questions/32183333/what-is-a-neat-command-line-equivalent-to-rstudios-knit-html
    input:
        unpack(smkf.hmlt_report_input)
    output:
        html_report = "Results/{genomes_not_fused}/Analysis/{lib_name}.html",
        xlsx_table = "Results/{genomes_not_fused}/Analysis/{lib_name}_for_NGS_files.xlsx"
        #RData = "Results/{genomes_not_fused}/Analysis/{lib_name}_aggregate_profile_data.RData" # --> How to make this output conditional? --Make another rule
    threads: 1
    envmodules:
        "R/4.1.2-mkl",
        "bioconductor/3.14"
    # log: "Results/Log_files/markdown_report_aggregate_profiles/{genomes_not_fused}/{lib_name}.log"
    params:
        top_5000_hs = lambda w: samples_table['top5000_HS_heatmap'].any(), # Is there any sample with heatmap on top5000 hs?
        top_5000_and_ssDNA = lambda w: ((samples_table['top5000_HS_heatmap']) &
         (samples_table['get_single_strand'])).any(), # Is there any sample with heatmap at top 5000 hs AND that has ssDNA profile as well (only these samples will have a plot at asymetric and X-nonPAR HSs)
