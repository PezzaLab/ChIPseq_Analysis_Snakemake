rule intersect_peaks_HSs_list:
    input:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/{sample}.{genomes_final}{extension}.{peak_type}Peak"
    output:
        "Results/{genomes_not_fused}/Peaks/MACS2/{peak_type_folder}/{peak_params}/Black-grey_filtered/Intersect_HSs_plus_minus_2000_bp/{sample}.{genomes_final}{extension}.{peak_type}Peak"
    wildcard_constraints:
        peak_type="broad|narrow",
        peak_type_folder="Broad|Narrow"
    # log:
    #     "Results/Log_files/intersect_peaks_HSs_list/{genomes_not_fused}/{peak_type_folder}.{peak_type}/{peak_params}/{sample}.{genomes_final}.{extension}log"
    threads: 1
    envmodules:
        "bedtools/2.30.0"
    params:
        hs_list = lambda w: config['references'][w.genomes_not_fused]['spo11']['all_plus_minus_2000']
    shell:
        """
        bedtools intersect -wa -a {input} -b {params.hs_list} > {output}
        """

rule compute_matrix_outfiles_hs:
    input:
        "Results/{genomes_not_fused}/Bigwigs/Coverage/{strands}/{cov_params}/{sample}.{genomes_final}{extension}{strand}.bw"
    output:
        filename = temp("Results/{genomes_not_fused}/Analysis/Heatmaps_and_aggregate_profiles/Hotspots/{hs_region}/{strands}/{cov_params}/filenames/{sample}.{genomes_final}{extension}{strand}.filename"), # This file is to be used by plotHeatmap
        matrix = "Results/{genomes_not_fused}/Analysis/Heatmaps_and_aggregate_profiles/Hotspots/{hs_region}/{strands}/{cov_params}/matrixes/{sample}.{genomes_final}{extension}{strand}.matrix", # This file is to do the aggregate profiles.
    # log:
    #     ""
    threads: 1
    envmodules:
        "deeptools/3.4.3"
    params:
        region = lambda w: config['references']['mm10']['spo11'][w.hs_region],
        before_region = config['heatmaps']['before_region'],
        after_region = config['heatmaps']['after_region'],
        bin_size = config['heatmaps']['bin_size']
    shell:
        """
computeMatrix reference-point -p max -R {params.region} -S {input} --sortRegions keep -b {params.before_region} -a {params.after_region} --outFileName {output.filename} --outFileNameMatrix {output.matrix} --referencePoint center --binSize {params.bin_size}
        """

