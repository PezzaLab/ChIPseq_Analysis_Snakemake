rule FRIP_narrow:
    input:
        peak = "Results/{genomes_not_fused}/Peaks/MACS2/Narrow/{peak_params}/Black-grey_filtered/{sample}.{genomes_final}{extension}.narrowPeak",
        bam = lambda w: samples_table_2.loc[w.sample, "dedup_flt_both_strds_bam"],
        bai = lambda w: samples_table_2.loc[w.sample, "dedup_flt_both_strds_bam"] + ".bai"
    output:
        "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/FRIP/MACS2_Narrow_{peak_params}_bl-gr_flt/{sample}.{genomes_final}{extension}.FRIP.txt"
    # log:
    #     "Results/Log_files/FRIP/{genomes_not_fused}/Narrow/{sample}.{genomes_final}.{peak_params}{extension}.log"
    threads: 1
    envmodules:
        "sambamba/0.8.2",
        "samtools/1.14"
    params:
        param1 = "1"
    shell:
        """
        echo "Getting total number of reads"
        total_reads=$( sambamba view -c {input.bam} )

        # Get reads in peak list
        echo "Getting number of reads in peaks"
        peak_reads=$( samtools view -L {input.peak} -c {input.bam} )

        FRIP=$( echo "scale=2; 100 * $peak_reads / $total_reads" | bc )

        echo "
        Sample name: $(basename {input.bam} bam)
        Total reads: $total_reads
        Reads in peaks: $peak_reads
        FRIP (%): $FRIP
        Anything below 1% is not good..." > {output}
        """

rule FRIP_broad:
    input:
        peak = "Results/{genomes_not_fused}/Peaks/MACS2/Broad/{peak_params}/{sample}.{genomes_final}{extension}_peaks.broadPeak",
        bam = lambda w: samples_table_2.loc[w.sample, "dedup_flt_both_strds_bam"],
        bai = lambda w: samples_table_2.loc[w.sample, "dedup_flt_both_strds_bam"] + ".bai"
    output:
        "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/FRIP/MACS2_Broad_{peak_params}_bl-gr_flt/{sample}.{genomes_final}{extension}.FRIP.txt"
    # log:
    #     "Results/Log_files/FRIP/{genomes_not_fused}/Broad/{sample}.{genomes_final}.{peak_params}{extension}.log"
    threads: 1
    envmodules:
        "sambamba/0.8.2",
        "samtools/1.14"
    params:
        param1 = "1"
    shell:
        """
        echo "Getting total number of reads"
        total_reads=$( sambamba view -c {input.bam} )

        # Get reads in peak list
        echo "Getting number of reads in peaks"
        peak_reads=$( samtools view -L {input.peak} -c {input.bam} )

        FRIP=$( echo "scale=2; 100 * $peak_reads / $total_reads" | bc )

        echo "
        Sample name: $(basename {input.bam} bam)
        Total reads: $total_reads
        Reads in peaks: $peak_reads
        FRIP (%): $FRIP
        Anything below 1% is not good..." > {output}
        """

rule crosscorrelation: # only processed bam
    input:
        lambda w: samples_table_2.loc[w.sample,'dedup_flt_both_strds_bam']
    output:
        pdf="Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/{sample}.crosscorrelation.pdf",
        tab="Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/{sample}.crosscorrelation.spp.out" # For multiqc, the suffix has to be ".spp.out"
    # log:
    #     "Results/Log_files/crosscorrelation/{genomes_not_fused}/{sample}.log"
    threads: 2
    envmodules:
        "phantompeakqualtools/1.2",
        "samtools/1.14",
        "sambamba/0.8.2",
        "picard/2.21.2",
        "deeptools/3.4.3"
    shell:
        """
    run_spp.R -c="{input}" -savp="{output.pdf}" -out="{output.tab}"
        """

rule samstats:
    input:
        unpack(smkf.get_qctrl_bams_bais)
    output:
        "Results/{genomes_not_fused}/Qctrl/{sample}/{bam_type}/{sample}.samstats.txt" # This file is actualy just a txt file, but to be able to use expand in multiqc I am using .tab
    threads: 2
    envmodules:
        "samtools/1.14",
    shell:
        """
    samtools stats {input.bam} > {output}
        """

rule samtools_flagstat:
    input:
        unpack(smkf.get_qctrl_bams_bais)
    output:
        "Results/{genomes_not_fused}/Qctrl/{sample}/{bam_type}/{sample}.flagstat.txt"
    threads: 2
    envmodules:
        "samtools/1.14",
    shell:
        """
    samtools flagstat {input.bam} > {output}
        """

rule insert_size_picard: # Only processed bam and PE. I put {bam_type} wildcard though to be able to use the function to get the input bam/bai
    input:
        lambda w: samples_table_2.loc[w.sample,'dedup_flt_both_strds_bam']
    output:
        tab = "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/{sample}.insert_size_picard.tab",
        pdf = "Results/{genomes_not_fused}/Qctrl/{sample}/Processed_bam/{sample}.insert_size_picard.pdf"
    threads: 2
    envmodules:
        "picard/2.21.2",
        "R/4.0.3-mkl"
    shell:
        """
    	picard CollectInsertSizeMetrics M=0.25 I={input} O={output.tab} H={output.pdf} VALIDATION_STRINGENCY=LENIENT ASSUME_SORTED=true VERBOSITY=INFO
        """

rule library_complexity_picard: # only raw bam and PE
    input:
        lambda w: samples_table_2.loc[w.sample, 'raw_bam'] # If I don't convert the wildcards to list, it returns a warning
    output:
        "Results/{genomes_not_fused}/Qctrl/{sample}/Raw_bam/{sample}.picard_library_complexity.tab"
    threads: 2
    envmodules:
        "picard/2.21.2"
    shell:
        """
    	picard EstimateLibraryComplexity I={input} O={output} VALIDATION_STRINGENCY=LENIENT VERBOSITY=INFO
        """

rule multiqc:
    input:
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/{sample}.crosscorrelation.spp.out",
        sample = samples_table['sample_name'].tolist()
        ),
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/{sample}.insert_size_picard.tab",
        sample = samples_table.loc[samples_table['PE'], 'sample_name'].tolist()
        ), # insert size only applies for PE samples
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Raw_bam/{sample}.picard_library_complexity.tab",
        sample = samples_table.loc[~samples_table['sample_name'].str.endswith("MERGED"), 'sample_name'].to_list() # Not applying this to merged files since they have already been dedupped. Before the command was: samples_table['sample_name'].tolist()
        ),
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Processed_bam/{sample}.{ext}",
        sample = samples_table['sample_name'].tolist(),
        ext = ["samstats.txt", "flagstat.txt"]
        ),
        expand(
        "Results/{{genomes_not_fused}}/Qctrl/{sample}/Raw_bam/{sample}.{ext}",
        sample = samples_table.loc[~samples_table['sample_name'].str.endswith("MERGED"), 'sample_name'].to_list() ,
        ext = ["samstats.txt", "flagstat.txt"] # Not applying this to merged files since they have already been dedupped. Before the command was: sample=samples_table['sample_name'].tolist()
        )
    output:
        directory("Results/{genomes_not_fused}/Qctrl/multiqc_report_{library}_data"),
        html = "Results/{genomes_not_fused}/Qctrl/multiqc_report_{library}.html"
    threads: 2
    envmodules:
        "multiqc/1.8"
    shell:
        """
config_file_path="$(pwd)/Config/multiqc_config.yaml"
cd Results/{wildcards.genomes_not_fused}/Qctrl && \
multiqc --dirs --dirs-depth 1 --filename "multiqc_report_{wildcards.library}.html" --config $config_file_path ./
# --dirs       : use directory name as part of sample name (not to overwrite data with same file name)
# --dirs-depth : how many directories should be used for the name of the sample
# --config     : path for config file
        """


