rule dros_normalization_report:
    input:
        smkf.dros_norm_report_input
    output:
        "Results/d6/Analysis/drosophila_normalization/{dros_eq_group}/drosophila_equalization_report.tsv"
    params:
        samples_table_2 = samples_table_2
    threads: 1
    script:
